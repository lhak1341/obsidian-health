{
	"name": "obsidian-health",
	"version": "0.1.0",
	"private": true,
	"description": "Health Dashboard Obsidian plugin",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"deploy": "bun run build && bun run scripts/deploy.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^9.30.1",
		"@types/node": "^22.10.0",
		"esbuild": "^0.24.0",
		"eslint": "^9.30.1",
		"eslint-plugin-obsidianmd": "0.4.1",
		"obsidian": "^1.7.2",
		"typescript": "^5.7.2",
		"typescript-eslint": "^8.35.1",
		"vitest": "^2.1.8"
	}
}
