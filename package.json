{
	"name": "obsidian-health",
	"version": "0.1.0",
	"private": true,
	"description": "Health Dashboard Obsidian plugin",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc --noEmit && node esbuild.config.mjs production",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"deploy": "bun run build && bun run scripts/deploy.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.2.0",
		"esbuild": "^0.28.2",
		"eslint": "^10.8.1",
		"eslint-plugin-obsidianmd": "0.4.1",
		"obsidian": "^1.7.2",
		"typescript": "5.9.3",
		"typescript-eslint": "^8.67.0",
		"vitest": "^4.1.11"
	}
}
